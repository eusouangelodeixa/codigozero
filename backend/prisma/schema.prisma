generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(uuid())
  name               String
  email              String           @unique
  phone              String           @unique
  passwordHash       String
  role               String           @default("member") // member, admin
  isActive           Boolean          @default(true)
  subscriptionStatus String           @default("active") // active, grace_period, overdue, canceled
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  renewalUrl         String?
  retentionCouponsUsed Int            @default(0)
  paymentsSinceLastCoupon Int         @default(0)
  lojouOrderId       String?
  checkoutUrl        String?
  lojouCustomerId    String?
  // Stripe identifiers. Populated by the Stripe webhook on first
  // payment / subscription creation. customerId is unique because
  // Stripe only ever creates one Customer per email-tier.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  dailySearchCount   Int              @default(0)
  lastSearchDate     DateTime?
  komunikaApiKey     String?
  komunikaInstanceId String?
  // ── Komunika embedded MODULE (provision + SSO) ──────────────────────
  // Set when the user buys the Komunika add-on (order bump KOMUNIKA_PID) and
  // we provision a tenant on api.komunika.site. NULL for the vast majority
  // of users. komunikaDeprovisionedAt is stamped on refund/cancel/expiry and
  // cleared on re-provision. The "Abrir Komunika" SSO button only renders
  // when komunikaCompanyId != null && komunikaDeprovisionedAt == null.
  // Independent of the funnel keys above (komunikaApiKey/komunikaInstanceId).
  komunikaCompanyId       String?
  komunikaUserId          String?
  komunikaProvisionedAt   DateTime?
  komunikaDeprovisionedAt DateTime?
  remarketingStage   String           @default("none") // none → visitor_sent | none → checkout_pending → checkout_failed_sent
  surveyAnswers      Json?
  avatarUrl          String?
  hasCompletedOnboarding Boolean @default(false)
  lastExpirationAlert DateTime?

  // ── Post-purchase onboarding / first platform access ────────────────
  // firstAccessAt is stamped the first time a paying member opens the app
  // (GET /api/auth/me). welcomeSentAt guards the one-time welcome WhatsApp.
  // The onboarding cron nudges buyers who haven't accessed yet (max 3, ~1/day),
  // stopping as soon as firstAccessAt is set. Existing users are backfilled as
  // already-accessed by the migration so they are never nudged.
  firstAccessAt          DateTime?
  welcomeSentAt          DateTime?
  onboardingNudgeCount   Int       @default(0)
  lastOnboardingNudgeAt  DateTime?

  // Access-recovery fallback (/resgate): stamped the one time a buyer reveals
  // their access on screen (when WhatsApp delivery failed). The reveal resets
  // the password and shows it once; subsequent attempts are blocked.
  accessRevealedAt       DateTime?

  // ── PWA install tracking ────────────────────────────────────────────
  // pwaInstalledAt is stamped the first time the authed app loads in
  // standalone/display-mode (added to home screen). pwaReminderSentAt is
  // set by the daily cron once it nudges a paid user who hasn't installed.
  pwaInstalledAt     DateTime?
  pwaReminderSentAt  DateTime?

  // ── Atribuição de anúncios (Meta) ───────────────────────────────────
  // Capturados no navegador quando a pessoa vira lead e guardados aqui porque
  // a COMPRA acontece depois, num webhook, sem browser do outro lado: sem o
  // par fbp/fbc o Meta não consegue ligar a venda ao anúncio que a gerou.
  // `landingUrl` é o event_source_url dessa mesma visita.
  fbp                String?
  fbc                String?
  landingUrl         String?

  // Origem da visita que gerou o lead. Guardado no nosso lado (além do Meta)
  // porque responde a pergunta que o Gerenciador não responde bem: QUAL anúncio
  // gerou esta venda em concreto, e quanto ela rendeu de facto.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?

  // ── "Salve o nosso contacto" (30–60 min depois da entrega de acessos) ──
  // Telemóveis escondem mensagens de números não guardados, por isso pedimos
  // ao comprador que grave o contacto pouco depois de receber as credenciais.
  // saveContactDueAt é agendado no momento da entrega (jitter 30–60 min) e
  // saveContactSentAt só é carimbado quando o envio confirma, para o cron
  // poder retentar se a Komunika estiver fora do ar.
  saveContactDueAt   DateTime?
  saveContactSentAt  DateTime?

  // ── Notification preferences (per channel) ──────────────────────────
  // Honoured by sendPushToUser(category) and the WhatsApp/cron senders.
  // Defaults true so existing users keep receiving everything.
  notifyCommunity    Boolean          @default(true)
  notifyPromotions   Boolean          @default(true)
  notifySystem       Boolean          @default(true)
  notifyExpiration   Boolean          @default(true)

  // ── Close Friends (order bump JQQWc): grants +2 months on top of the
  // standard subscription, expires together with subscriptionEnd, and is
  // automatically dropped on a renewal payment that doesn't include the bump.
  closeFriends              Boolean   @default(false)
  closeFriendsUntil         DateTime?
  closeFriendsPurchaseCount Int       @default(0)

  // Set when the admin grants a subscription manually (free, trial, comp,
  // refund recovery, etc) instead of a real Lojou payment. Treated as
  // paid for access control, but EXCLUDED from MRR/revenue counts and
  // never gets a Transaction record. Prevents fake numbers in finance.
  grantedManually           Boolean   @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Affiliate program
  referredByCode     String?              // affiliate code that brought this user in
  affiliateAccount   AffiliateAccount?    // becomes an affiliate themselves
  affiliateReferrals AffiliateReferral[]  @relation("AffiliateReferralUser")

  // Coproducer attribution — set when a lead/user enters via /c/{code}.
  // Lets the system route renewals and remarketing back to the right
  // coproducer (and feeds the source filter in admin/finance).
  referredByCoproducer String?
  coproducerAccount    CoproducerAccount?

  // Lead-capture source — stamped when this person was FIRST captured via a
  // content/lead-magnet page (Instagram organic funnel). Format
  // "content:{slug}". Null for landing/affiliate/coproducer/manual origins.
  // Lets /admin/leads filter "leads desta isca" and measure per-page funnels.
  leadSource           String?

  // Delayed newsletter welcome for content-page leads. On capture we schedule
  // a ONE-TIME welcome WhatsApp for ~10–20 min later; a low-rate cron then
  // sends them one at a time, well spaced, daytime CAT (anti-ban — see the
  // shared Komunika number). dueAt = becomes eligible; sentAt = delivered.
  newsletterWelcomeDueAt  DateTime?
  newsletterWelcomeSentAt DateTime?

  // Revenue-share partner (sócio). A user who takes a fixed % of the
  // main product's net revenue, paid out internally by Código Zero.
  // Independent of CoproducerAccount (which is per-product / Lojou-split).
  partnerAccount       PartnerAccount?

  // Post-purchase satisfaction survey (D+14 polls / D+21 suggestion).
  // One per user EVER — renewals never re-trigger it.
  feedbackSurvey       FeedbackSurvey?

  leads              Lead[]
  lessonProgress     LessonProgress[]
  courseAccesses     CourseAccess[]
  credentialDelivery CredentialDelivery?
  chatMessages       ChatMessage[]      @relation("ChatSender")
  messageReactions   MessageReaction[]
  pinnedMessages     ChatMessage[]      @relation("ChatPinnedBy")
  chatMentions       ChatMention[]
  pollVotes          PollVote[]
  dispatchLogs       DispatchLog[]
  pushSubscriptions  PushSubscription[]
  scheduledDispatches ScheduledDispatch[]
  notificationLogs   NotificationLog[]
  costsCreated       Cost[]            @relation("CostCreatedBy")

  @@index([komunikaCompanyId])
  // Colunas quentes: todo cron (assinatura/alertas/remarketing/onboarding) filtra
  // por subscriptionStatus; a renovação Stripe faz findFirst por stripeSubscriptionId
  // a cada fatura; o funil filtra por remarketingStage.
  @@index([subscriptionStatus])
  @@index([stripeSubscriptionId])
  @@index([remarketingStage])
  // Auditoria 2026-08: as queries quentes que estas colunas servem estão no
  // relatório Raio-X (expiração diária, expectedRenewals do /finance, listas
  // do admin por createdAt, crons de welcome/save-contact, painel do copro).
  @@index([subscriptionStatus, subscriptionEnd])
  @@index([subscriptionEnd])
  @@index([createdAt])
  @@index([newsletterWelcomeSentAt, newsletterWelcomeDueAt])
  @@index([saveContactSentAt, saveContactDueAt])
  @@index([referredByCoproducer])
}

model Lead {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  address   String?
  category  String
  location  String
  rating    Float?
  website   String?
  source    String   @default("google_maps")
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScriptFolder {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  sortOrder Int      @default(0)
  scripts   Script[]
  createdAt DateTime @default(now())
}

model Script {
  id        String       @id @default(uuid())
  title     String
  content   String
  icon      String?
  sortOrder Int          @default(0)
  folderId  String
  folder    ScriptFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([folderId])
}

// ── Área de membros multi-curso (members.czero.sbs) ─────────────────────
// Um Course agrupa Modules→Lessons e carrega TODA a personalização visual
// (tema, menu, login, home) em `config` Json — mesclado no frontend com
// MEMBER_DEFAULTS (frontend/lib/members/defaults.ts), mesmo padrão do
// LandingConfig.sections. Todo assinante ativo vê todos os cursos
// published (sem entitlements por curso na v1). O curso legado da Forja é
// o uuid fixo c0000000-0000-4000-8000-000000000001 (slug codigo-zero),
// criado pela migração members_courses com backfill dos módulos.
model Course {
  id        String   @id @default(uuid())
  slug      String   @unique // members.czero.sbs/{slug} — proibidos: login|sso|cursos
  name      String
  coverUrl  String?  // capa 640x360 da grade "Meus Cursos" (espelho de config.branding.coverUrl)
  status    String   @default("draft") // draft | published
  sortOrder Int      @default(0)
  config    Json?    // { theme, branding, menu, home } — ver MemberConfig no frontend

  // ── Como se ganha acesso a este curso ────────────────────────────────
  // 'subscription' = incluído na assinatura (comportamento histórico: todo
  //                  assinante activo vê o curso publicado).
  // 'paid'         = vendido à parte; só entra quem tiver CourseAccess.
  // Em qualquer dos casos um CourseAccess individual dá entrada — é o que
  // permite acesso VITALÍCIO, que sobrevive ao fim da assinatura.
  accessType   String  @default("subscription")
  // pid do produto na Lojou, para confirmar que a venda é mesmo deste curso.
  productPid   String?
  // Token da rota de webhook própria (/api/webhooks/course/{token}). Curso
  // pago NÃO pode usar o webhook principal: aquele não valida pid nenhum e
  // trataria a compra como assinatura completa da plataforma.
  webhookToken String? @unique
  // Ferramentas da plataforma que um aluno GANHA por entrar neste curso.
  // null = tudo (é o comportamento de sempre — não mexer nos cursos que já
  // existem). Lista vazia = nenhuma. Ex.: ["komunika"].
  // Serve para turmas que compram só o curso: o COD, por exemplo, não dá
  // Komunika; para ter, a pessoa assina o Código Zero à parte.
  includedTools Json?

  // ── Coprodução e funil de venda ──────────────────────────────────────
  // Coprodutor associado a este curso (um por curso). Dá a ele visão de
  // alunos + faturamento do curso e o poder de matricular alunos. O acerto
  // financeiro é por fora (Lojou/manual) — nada disto entra no rateio de
  // sócios.
  coproducerId String?
  coproducer   CoproducerAccount? @relation(fields: [coproducerId], references: [id])
  // Link público de compra (https://pay.lojou.app/p/...) mostrado no
  // cadeado do curso pago. Sem ele, a tela bloqueada não tem CTA.
  checkoutUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules      Module[]
  accesses     CourseAccess[]
  transactions Transaction[]

  @@index([coproducerId])
}

/// Direito de acesso de uma pessoa a um curso.
///
/// É o que faltava na área de membros: até aqui o acesso era binário —
/// assinante activo via tudo o que estava publicado. Com isto passam a existir
/// dois eixos independentes: a assinatura, que expira, e o direito ao curso,
/// que pode ser VITALÍCIO (`expiresAt` nulo) e sobreviver ao fim dela.
///
/// Cobre a turma de mentoria (curso vitalício + 1 mês de plataforma) e os
/// cursos vendidos à parte (a compra cria a linha).
/// Fila de entrega de credenciais.
///
/// Existe porque uma turma inteira não pode receber tudo de uma vez: o e-mail
/// tem tecto diário e o WhatsApp sai por um número partilhado, onde uma rajada
/// é o caminho curto para o ban. A entrega passa a ser assíncrona e persistida
/// — sobrevive a restart, ao contrário de um laço em memória, e uma turma
/// grande pode demorar horas (ou dias, no WhatsApp) sem perder ninguém.
///
/// A senha NÃO é guardada aqui de propósito: é gerada no momento do envio e
/// gravada no utilizador nesse instante. Guardar credenciais em claro à espera
/// numa tabela seria pior do que o problema que resolve.
model CredentialDelivery {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// email | whatsapp — começa sempre em email; só cai para whatsapp quando a
  /// quota diária de e-mail acaba.
  channel   String   @default("email")
  /// pending | sent | failed
  status    String   @default("pending")
  attempts  Int      @default(0)
  /// Quando pode sair. No WhatsApp é espaçado 15–20 min entre pessoas.
  dueAt     DateTime @default(now())
  sentAt    DateTime?
  lastError String?
  /// Rótulo da origem (ex.: "turma-cod") — para o admin saber de onde veio.
  batch     String?
  /// Nome do produto comprado (ex.: "Curso COD do Zero") — entra na mensagem
  /// de credenciais para o aluno saber exatamente o que desbloqueou. Nulo =
  /// mensagem genérica da plataforma.
  productName String?
  createdAt DateTime @default(now())

  @@index([status, dueAt])
  // Slot do WhatsApp: findFirst do último enviado por canal a cada tick.
  @@index([channel, sentAt])
}

model CourseAccess {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// manual (admin) | import (turma) | purchase (webhook do curso)
  source      String    @default("manual")
  /// null = vitalício; com data, expira como uma assinatura.
  expiresAt   DateTime?
  /// Pedido que desbloqueou, quando veio de compra.
  orderId     String?
  /// Admin que concedeu, quando foi manual ou importação.
  grantedById String?
  createdAt   DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String?  // legado (emoji) — a UI nova usa coverUrl
  coverUrl    String?  // poster vertical do carrossel de módulos
  // Amostra: visível a quem ainda não comprou. Os restantes aparecem com
  // cadeado — mostrar o que está por trás vende melhor do que esconder.
  isFree      Boolean  @default(false)
  sortOrder   Int      @default(0)
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String   @id @default(uuid())
  moduleId     String
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  videoUrl     String
  duration     Int?     // seconds
  sortOrder    Int      @default(0)
  thumbnailUrl String?  // miniatura na lista de aulas / drawer do player
  tools        Json?    // recommended tools
  content      String?  // lesson text content (markdown)
  materials    Json?    // [{name, url, type}] — links, PDFs, resources
  createdAt    DateTime @default(now())

  progress LessonProgress[]

  @@index([moduleId])
}

model LessonProgress {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  rating       Int?      // 1..5 — avaliação (estrelas) do usuário nesta aula
  lastViewedAt DateTime? // última abertura da aula — alimenta "Continuar assistindo"

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, lastViewedAt])
}

model Transaction {
  id            String   @id @default(uuid())
  orderId       String   @unique
  userEmail     String?
  userPhone     String?
  userName      String?
  // amount is always the TOTAL charged (principal + any order bumps).
  // Faturamento/MRR reports keep reading this field as-is.
  amount        Float
  currency      String   @default("MZN")
  status        String   // pending, approved, failed, refunded
  paymentMethod String?
  metadata      Json?
  // ── Gross + fee breakdown (audit) ─────────────────────────────────────
  // amount above is the GROSS charged; o líquido fica em `netAmount`.
  // These columns let the admin see the full economic picture without
  // having to parse metadata payloads.
  grossAmount     Float?   // sum of product + bump prices the customer paid
  lojouFee        Float?   // platform fee deducted (10% × gross + 10 per item)
  coproducerFee   Float?   // coproducer split deducted (sharePct × principal)
  // O que SOBRA de facto (bruto − taxa Lojou − split do coprodutor). Antes isto
  // era calculado e deitado fora: o painel rotulava `amount` como "Líquido",
  // mas `amount` é o BRUTO — a receita aparecia inflada pela taxa (~11%).
  // `amount` continua a ser o bruto de propósito: a comissão de sócios parte
  // dele e desconta a taxa por conta própria (partner.service.ts).
  netAmount       Float?
  // ── Order bump audit fields ──────────────────────────────────────────
  orderBumpPid    String?  // e.g. "JQQWc" for Close Friends
  orderBumpAmount Float?   // bump amount only, so reports can split principal vs bump
  isCloseFriends  Boolean  @default(false)
  // True when the buyer was an existing user being reactivated/renewed,
  // false when this was their first paid order. Set by the webhook;
  // back-populated for historical rows via migration.
  isRenewal       Boolean  @default(false)
  // Coproducer attribution: set by the webhook when the order pid matches
  // a registered coproducer product, or when the buyer's User row carries
  // referredByCoproducer. NULL = principal (main product).
  coproducerId    String?
  coproducer      CoproducerAccount? @relation(fields: [coproducerId], references: [id])
  // ── Identificação do produto vendido ─────────────────────────────────
  // pid + nome do produto como vieram do gateway. Antes disto o produto só
  // sobrevivia dentro de metadata (JSON cru, inconsultável). courseId marca
  // venda de CURSO avulso — essas nunca entram no rateio de sócios.
  productPid      String?
  productName     String?
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id])
  // Payment gateway that produced this transaction. Default 'lojou' for
  // historical rows. Values: 'lojou' | 'stripe' | 'manual'.
  gateway                 String   @default("lojou")
  stripePaymentIntentId   String?
  stripeInvoiceId         String?
  createdAt     DateTime @default(now())

  @@index([coproducerId])
  @@index([courseId])
  // Colunas quentes: faturamento/cron filtram por status; renovação por userEmail;
  // reconciliação Stripe faz findFirst por stripePaymentIntentId; relatórios por data.
  // (status, createdAt) porque TODA query do financeiro é status + janela de
  // data; userPhone porque o feedback/leads casam por telefone e não havia
  // índice nenhum.
  @@index([status, createdAt])
  @@index([userPhone])
  @@index([status])
  @@index([userEmail])
  @@index([stripePaymentIntentId])
  @@index([createdAt])
}

model SystemConfig {
  id                       String  @id @default("singleton")
  maxUsers                 Int     @default(50)
  currentUsers             Int     @default(0)
  communityLink            String?
  mentoriaSchedule         String? // next mentoria ISO datetime
  mentoriaLink             String?
  // Dedup markers for the live-mentoria push reminders: each stores the
  // mentoriaSchedule value already notified, so the cron fires once per schedule
  // (and re-fires when the admin changes the date).
  mentoria30SentFor        String?
  mentoriaStartSentFor     String?
  komunikaVisitorAssistantId  String?
  komunikaCheckoutAssistantId String?
  komunikaAdminApiKey      String?
  komunikaInstanceId       String? // Komunika WhatsApp instance ID
  milestoneAlertPhone      String?
  milestoneAlertName       String?
  // Resend (e-mail) — configured from /admin/config. Falls back to env when null.
  resendApiKey             String?
  resendFrom               String?
  // Svix signing secret for the Resend webhook (whsec_…) — verifies inbound events.
  resendWebhookSecret      String?
  // Newsletter welcome for content-page leads — editable from /admin/config.
  // When disabled, the welcome cron drains the queue WITHOUT sending. The
  // message supports a {nome} placeholder (replaced with the lead's first name).
  newsletterWelcomeEnabled Boolean @default(true)
  newsletterWelcomeMessage String?
  // Post-purchase feedback surveys — kill switch (send tick idles when false;
  // enrollment keeps running so nothing is lost, only delayed).
  feedbackEnabled          Boolean @default(true)
  // HMAC secret (whsec_…) of the CZ endpoint registered in the Komunika
  // dashboard → Webhooks. Verifies X-Komunika-Signature on inbound events.
  komunikaWebhookSecret    String?
  // Banners rotativos da tela inicial do app do aluno (máx. 5) — mesmo formato
  // dos slides da área de membros: [{ id, imageUrl, mobileImageUrl?, linkUrl? }].
  dashboardBanners         Json?
  // Grupo do WhatsApp EXCLUSIVO de membros (assinantes): id/nome do grupo no
  // Komunika (o monitor em /admin/grupo cruza participantes × assinaturas) e o
  // link de convite exibido no QG (grupo privado — o Angelo aprova a entrada).
  membersGroupId           String?
  membersGroupName         String?
  membersGroupInviteLink   String?

  // ── Meta / Conversions API ────────────────────────────────────────────
  // O pixel do navegador continua a vir de `LandingConfig.bodyScripts`; estes
  // campos são para o envio server-side (que sobrevive a bloqueadores e é o
  // único caminho possível para a compra, que acontece num webhook).
  // `metaTestEventCode` só deve ficar preenchido enquanto se testa no
  // "Eventos de teste" do Gerenciador — em produção fica vazio.
  metaPixelId              String?
  metaCapiToken            String?
  metaTestEventCode        String?

  // ── Orçamento diário de e-mail (Resend) ───────────────────────────────
  // A entrega de credenciais de uma turma vai TODA por e-mail primeiro; o
  // WhatsApp é o plano B, porque o número é partilhado e uma rajada leva ban.
  // `emailQuotaDate` é o dia (YYYY-MM-DD) a que `emailQuotaUsed` se refere —
  // muda o dia, o contador zera sozinho. `emailQuotaExhausted` é ligado
  // quando o próprio Resend recusa por limite (429), mesmo antes do contador
  // bater no tecto.
  emailDailyLimit          Int      @default(100)
  emailQuotaDate           String?
  emailQuotaUsed           Int      @default(0)
  emailQuotaExhausted      Boolean  @default(false)

  // ── Suporte: janela de atendimento ────────────────────────────────────
  // O horário é o COMERCIAL BRASILEIRO (UTC-3, sem horário de verão desde
  // 2019) — diferente do resto da plataforma, que raciocina em CAT (UTC+2).
  // Fora da janela o suporte fica congelado: o aluno lê o histórico mas não
  // envia, e a tela mostra quando reabre. Seg–Sex apenas.
  supportHoursEnabled      Boolean @default(true)
  supportStartHour         Int     @default(8)
  supportEndHour           Int     @default(18)
  // WhatsApp que recebe o aviso da PRIMEIRA mensagem de cada sessão de
  // suporte (com os dados do assinante e o número dele para responder).
  supportNotifyPhone       String?
  supportNotifyName        String?
  // Silêncio do aluno, em horas, a partir do qual a próxima mensagem volta a
  // contar como início de sessão e dispara um novo aviso.
  supportRearmHours        Int     @default(4)
}

// Mensagens do admin pro grupo de membros (texto / mídia / áudio-voz PTT),
// enviadas na hora ou AGENDADAS — o cron processa 1 por tick (pacing) e o
// histórico aparece em /admin/grupo. kind: text | media | audio.
model GroupMessageQueue {
  id          String    @id @default(uuid())
  kind        String
  content     String?   // texto da mensagem ou legenda da mídia
  mediaUrl    String?   // URL absoluta da mídia (imagem/vídeo) ou do áudio
  mentionAll  Boolean   @default(false)
  scheduledAt DateTime  @default(now())
  status      String    @default("pending") // pending | sent | failed | canceled
  attempts    Int       @default(0)
  error       String?
  createdBy   String?   // e-mail do admin (auditoria)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// Fila de remoção do grupo de membros: remover via /admin/grupo AGENDA aqui e
// o cron processa em lotes pequenos (3) com intervalo aleatório de 10-15 min
// (anti-ban: imita admin humano). Na hora do lote a assinatura é RE-CHECADA —
// quem renovou na espera é pulado (status skipped), nunca removido.
model GroupRemovalQueue {
  id          String    @id @default(uuid())
  jid         String
  phone       String
  name        String?
  status      String    @default("pending") // pending | done | skipped | failed
  attempts    Int       @default(0)
  error       String?
  requestedBy String?   // admin (email) que agendou — auditoria
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([jid, status])
}

// Fila do aviso no grupo do WhatsApp: publicar um conteúdo na Central agenda
// UM anúncio (resumo + link central.czero.sbs/?m={slug}) para ~10 min depois,
// enviado pelo cron via Komunika ao grupo escolhido em /admin/lp. pageId é
// único: cada conteúdo anuncia UMA vez, mesmo que despublique/republique.
model CentralAnnouncement {
  id        String    @id @default(uuid())
  pageId    String    @unique
  dueAt     DateTime
  sentAt    DateTime?
  status    String    @default("pending") // pending | sent | skipped | failed
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, dueAt])
}

// Delivery events streamed in by the Resend webhook (sent/delivered/bounced/…),
// powering the real-time e-mail status panel in /admin/emails.
model EmailEvent {
  id        String   @id @default(uuid())
  resendId  String?  // Resend message id (data.email_id)
  type      String   // email.sent | email.delivered | email.bounced | email.complained | email.opened | email.clicked | email.delivery_delayed
  recipient String?
  subject   String?
  raw       Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([resendId])
}

model LandingConfig {
  id            String  @id @default("singleton")
  vslEmbedUrl   String? // legacy — simple URL
  vslEmbedHtml  String? // raw iframe HTML (Kilax, YouTube, etc)
  heroTitle     String?
  heroSubtitle  String?
  heroDesc      String?
  ctaText       String?
  priceAmount   Int     @default(297)
  maxVagas      Int     @default(50)
  sections      Json?   // full page sections as JSON
  headScripts       String? // Tracking pixels for <head> (concatenated)
  headScriptBlocks  String? // Tracking pixels as JSON array [{name, code}]
  bodyScripts       String? // Tracking pixels for <body>
  // Affiliate-specific overrides (used when the visitor lands via /r/{code})
  affiliateVslEmbedHtml  String?
  affiliateCreativesUrl  String?
  updatedAt         DateTime @updatedAt
}

model ScrapeJob {
  id        String   @id @default(uuid())
  userId    String
  query     String
  // Human-friendly campaign label (defaults to "<query> — <cities>").
  // Lets users find and dispatch to a specific prospecting run instead of
  // one giant flat list of leads. Renameable from the Radar UI.
  name      String?
  // Soft-delete / hide a campaign from the Radar list without dropping its
  // leads. New campaigns are visible (false).
  archived  Boolean  @default(false)
  // Single-city legacy column (kept for backwards compat with old jobs).
  // New jobs populate `cities` (JSON array). The worker reads cities ??
  // [city] so both shapes resolve to a list.
  city      String
  cities    Json?    // string[] — multi-city support
  status    String   // processing, completed, failed
  leads     ScrapedLead[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScrapedLead {
  id          String   @id @default(uuid())
  jobId       String
  job         ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  address     String?
  website     String?
  instagram   String?
  status      String   // "Sem Website", "Website Lento/Antigo", "Website Bom"
  recommendedScriptId String? // ID do script sugerido
  // Google Maps enrichment — captured by the worker from the Maps detail
  // page. mapsUrl is the canonical place link; placeId is the stable
  // identifier; rating/reviewsCount surface social proof in the UI.
  mapsUrl       String?
  placeId       String?
  rating        Float?
  reviewsCount  Int?
  latitude      Float?
  longitude     Float?
  // City that produced this lead (relevant when the job has multiple
  // cities — lets the UI/CSV show which city each lead came from).
  city          String?
  createdAt   DateTime @default(now())

  @@index([jobId])
  // Radar lista os leads do usuário ordenados por data com take 500 — sem
  // este índice o Postgres ordenava o histórico inteiro em memória.
  @@index([jobId, createdAt])
}

model ChatMessage {
  id        String    @id @default(uuid())
  senderId  String
  sender    User      @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  channel   String    // "community" or "support_{userId}"

  // Message kind: "text" (default; also covers mention-only text), "image",
  // "audio", "poll". Existing rows backfill to "text" via the column default.
  type      String    @default("text")
  content   String    // text body, or caption for media (may be empty for media/poll)

  // Media (type=image|audio): stored under /uploads/chat/* and served statically.
  mediaUrl         String?
  mediaMime        String?
  mediaDurationSec Int?     // audio length in seconds (for the player)

  // @todos — notifies the whole community. Admin-only (enforced in the route).
  mentionsAll Boolean @default(false)

  // Pin (admin-only). A message is "currently pinned" when pinnedUntil is in the
  // future; it auto-unpins once that passes (filtered at read time).
  pinnedUntil DateTime?
  pinnedAt    DateTime?
  pinnedById  String?
  pinnedBy    User?     @relation("ChatPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // WhatsApp-style reply: the message this one is quoting (same channel).
  // SetNull so deleting the quoted message doesn't cascade-delete replies.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  reactions MessageReaction[]
  mentions  ChatMention[]
  poll      Poll?

  @@index([channel, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([channel, pinnedUntil])
  // Contagem de não-lidas do suporte (polls de 4–8s do admin).
  @@index([channel, readAt])
}

// One emoji reaction by one user on one message. Unique per (message,user,emoji)
// so re-reacting with the same emoji toggles it off in the route handler.
model MessageReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// A user mentioned (@membro) in a chat message. Drives the in-bubble highlight
// plus a targeted push. @todos is stored as mentionsAll on ChatMessage instead
// (admin-only), so it doesn't create a row per member.
model ChatMention {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

// A poll attached 1:1 to a ChatMessage (type="poll"). Options + votes hang off
// it. Single-choice by default; allowMultiple lets a user pick several options.
model Poll {
  id            String       @id @default(uuid())
  messageId     String       @unique
  message       ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question      String
  allowMultiple Boolean      @default(false)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  options       PollOption[]
  votes         PollVote[]
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int        @default(0)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // One row per (option,user). Single-choice polls clear a user's prior votes
  // in the route before inserting; multi-select keeps several rows.
  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@index([optionId])
}

model DispatchLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  contactName String?
  message     String
  status      String   @default("sent") // sent, failed
  error       String?
  scheduleId  String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([scheduleId])
}

model ScheduledDispatch {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Human-friendly campaign label so the Disparador groups sends into named
  // campaigns (like Radar). Defaults to an auto-name when not provided.
  name        String?
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  status      String    @default("pending") // pending, running, completed, failed, cancelled
  payload     Json
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  // Cursor de progresso: índice do PRÓXIMO contato a enviar. Sem ele, um
  // restart no meio do disparo recomeçava do contato 0 e duplicava envios
  // no número compartilhado.
  lastContactIndex Int  @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

/// Disparo em massa do admin (/admin/broadcast), PERSISTIDO. Antes vivia num
/// Map em memória: um deploy no meio matava o loop sem registro de quem já
/// tinha recebido, sem resume, e o botão de pausa só valia no processo dono.
/// Agora o loop lê o status daqui (pausa/stop de qualquer processo), cada
/// destinatário tem a sua linha (dedup + resume), e o boot retoma jobs vivos.
model AdminBroadcast {
  id           String    @id @default(uuid())
  /// running | paused | stopped | done | error
  status       String    @default("running")
  message      String
  instanceId   String?
  delayMin     Int       @default(5)
  delayMax     Int       @default(15)
  sendPush     Boolean   @default(false)
  generateCoupons Boolean @default(false)
  couponDiscount  Int?
  couponMaxUses   Int?
  total        Int       @default(0)
  sent         Int       @default(0)
  failed       Int       @default(0)
  coupons      Int       @default(0)
  error        String?
  createdBy    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  recipients   AdminBroadcastRecipient[]

  @@index([status])
}

model AdminBroadcastRecipient {
  id        String   @id @default(uuid())
  jobId     String
  job       AdminBroadcast @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  name      String?
  phone     String?
  /// pending | sending | sent | failed | skipped
  status    String   @default("pending")
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([jobId, status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time verification codes delivered over WhatsApp.
///
/// Used for two flows:
///   • password_reset  — forgot-password (unauthenticated, matched by phone)
///   • password_change — authed password change confirmation in /perfil
///
/// A code is 6 digits, expires after 10 minutes, and is single-use
/// (consumedAt). `attempts` backs off brute-force on the verify step.
model OtpCode {
  id         String    @id @default(uuid())
  userId     String?   // set for password_change (known user); null for reset
  phone      String    // normalized E.164 digits (no +)
  code       String    // 6-digit numeric
  purpose    String    // 'password_reset' | 'password_change'
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

// ═══════════════════════════════════════════
// AFFILIATE PROGRAM
// ═══════════════════════════════════════════

model AffiliateAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String   @unique               // 7–9 alphanumeric chars
  enabled       Boolean  @default(true)
  payoutMethod  String?                        // "mpesa" | "emola"
  payoutTarget  String?                        // phone number to receive funds
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrals     AffiliateReferral[]
  commissions   AffiliateCommission[]
  withdrawals   AffiliateWithdrawal[]

  @@index([code])
}

model AffiliateReferral {
  id            String           @id @default(uuid())
  affiliateId   String
  affiliate     AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  email         String?
  phone         String?
  // Once the lead pays, link to the resulting user account
  userId        String?
  user          User?            @relation("AffiliateReferralUser", fields: [userId], references: [id], onDelete: SetNull)
  status        String           @default("pending") // pending | paid | refunded | lost_to_remarketing
  paidAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([affiliateId, status])
  @@index([email])
}

model AffiliateCommission {
  id            String           @id @default(uuid())
  affiliateId   String
  affiliate     AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId    String?
  lojouOrderId  String?
  saleAmount    Float
  grossAmount   Float            // commission before platform fee
  feeAmount     Float            // platform fee (10% of sale + fixed)
  netAmount     Float            // grossAmount - feeAmount (what's added to balance)
  availableAt   DateTime         // commission becomes withdrawable from this date (D+7)
  status        String           @default("pending") // pending | available | withdrawn | refunded
  withdrawalId  String?          // populated when included in a withdrawal payout
  createdAt     DateTime         @default(now())

  @@index([affiliateId, status])
  @@index([availableAt, status])
  @@index([withdrawalId])
}

model AffiliateWithdrawal {
  id              String           @id @default(uuid())
  affiliateId     String
  affiliate       AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountRequested Float            // total gross (sum of net commissions consumed)
  feeAmount       Float            // 3% + 45 MZN
  amountNet       Float            // what the affiliate actually receives
  payoutMethod    String           // "mpesa" | "emola"
  payoutTarget    String
  status          String           @default("pending") // pending | paid | rejected
  notes           String?
  processedAt     DateTime?
  processedBy     String?          // admin user id who approved/rejected
  createdAt       DateTime         @default(now())

  @@index([affiliateId, status])
  @@index([status, createdAt])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  type          String   @default("percentage") // percentage, fixed
  value         Float
  maxUses       Int      @default(1)
  usesCount     Int      @default(0)
  active        Boolean  @default(true)
  lojouId       String?  // ID returned from Lojou after creation
  linkedUserId  String?  // optional: linked to specific user
  linkedUserEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformMilestone {
  id          String    @id @default(uuid())
  category    String    // "revenue" | "subscribers"
  targetValue Float
  reached     Boolean   @default(false)
  reachedAt   DateTime?
  notified    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([category, targetValue])
}

// ─────────────────────────────────────────────────────────
// Coproducer program
// ─────────────────────────────────────────────────────────
// A coproducer is a partner who sells the Código Zero offer under their
// own Lojou product pid. They get a personalised landing page at
// /c/{code}; every sale made through that page lands on their Lojou
// pid and is split by Lojou's own coproduction settings.
//
// The system uses `productPid` to back-attribute incoming webhooks
// (matches data.product.pid → CoproducerAccount.productPid). Leads
// captured on /c/{code} also persist `referredByCoproducer = code`
// on the User row as a secondary attribution signal.
//
// `sharePct` is documentation only — Lojou handles the actual split.
model CoproducerAccount {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Public code used in /c/{code} URLs. Short, copyable.
  code                String   @unique
  // Lojou product identifier owned by the coproducer. Webhook attribution
  // matches `data.product.pid` to this column.
  productPid          String   @unique
  // Optional plan id (Lojou)
  planId              String?
  // Public Lojou checkout fallback (https://pay.lojou.app/p/...)
  publicCheckoutUrl   String?
  // Coproducer's share of each sale (0-100). Lojou itself enforces the
  // split — this is shown in the coproducer dashboard for transparency.
  sharePct            Float    @default(50)
  // Order bump cadastrado por este coprodutor (opcional). Quando a Lojou
  // confirma um pedido contendo este pid, o webhook marca isCloseFriends
  // e estende a assinatura em +60 dias (mesma regra do bump principal).
  bumpProductPid      String?
  bumpPrice           Float?
  // Display name shown on dashboards / admin lists. Falls back to the
  // linked User.name when null.
  displayName         String?
  enabled             Boolean  @default(true)
  notes               String?
  // Token da URL de webhook DESTA coprodução (vendas via conta própria na
  // plataforma): POST /api/webhooks/lojou/copro/{token}. O token é a
  // autenticação; atribuição é forçada a esta conta. Gerado no cadastro,
  // rotacionável no admin.
  webhookToken        String?  @unique

  // VSL embed (iframe HTML) que substitui o VSL principal na landing
  // /c/{code}. Só o superadmin edita — o coprodutor apenas visualiza.
  vslEmbedHtml        String?
  // Tags de rastreio (Meta Pixel, GA, TikTok etc.) que o coprodutor injeta
  // no <head> da própria landing /c/{code}. O coprodutor edita; superadmin
  // também pode editar/auditar.
  headScripts         String?

  // ── Push notification preferences ───────────────────────────────────
  // O coprodutor habilita push uma vez (subscribe do browser via VAPID,
  // mesma máquina do admin) e depois liga/desliga por tipo aqui. Quando
  // false, o helper notifyCoproducer pula o envio mas ainda persiste no
  // NotificationLog pra histórico/auditoria.
  notifySale            Boolean  @default(true)
  notifyRenewal         Boolean  @default(true)
  notifyLead            Boolean  @default(true)
  notifyCredentialFail  Boolean  @default(true)

  transactions        Transaction[]
  // Cursos da área de membros associados a esta coprodução (um coprodutor
  // por curso; um coprodutor pode ter vários cursos).
  courses             Course[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([enabled])
}

/// Feed de atividade do painel admin — UMA linha por evento operacional
/// relevante (venda de curso, aluno matriculado por coprodutor, …), visível a
/// todos os admins na aba Atividade. Diferente do NotificationLog, que é
/// histórico de push POR usuário. O push aos superadmins continua saindo por
/// sendPushToSuperAdmins; isto é o registro consultável.
model AdminEvent {
  id        String   @id @default(uuid())
  /// course_sale | copro_enroll | …
  type      String
  title     String
  body      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

/// Notification history — one row per push attempt sent to a user.
///
/// Used by /coproducer/notifications to display the recent notification
/// feed. Generic per-userId so admins or any other role could read their
/// own history through a similar endpoint in the future, but for now
/// it's only written from notifyCoproducer().
///
/// Persisted even when `delivered=0` (no active subscriptions) — that
/// way the coprodutor can still see "uma venda aconteceu" mesmo se ele
/// não tinha o navegador inscrito naquele momento.
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'sale' | 'renewal' | 'lead' | 'credential_fail' | 'test' | 'system'
  title     String
  body      String
  url       String?
  delivered Int      @default(0)  // number of subscriptions that received the push
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════
// REVENUE SHARE — SÓCIOS (internal partners)
// ═══════════════════════════════════════════
// Unlike CoproducerAccount (each coproducer owns a Lojou product and Lojou
// splits natively), the sócios all share the SAME main product. Every paid
// order lands on one Lojou account; Código Zero splits the NET (after the
// Lojou fee) among the partners by a fixed sharePct. Each partner sees their
// balance in real time and requests a withdrawal (3% + 35 MZN), approved by
// an admin — exactly like the affiliate program. Affiliate-attributed sales,
// external-coproducer sales and Stripe sales are EXCLUDED from the pool.

model PartnerAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?              // e.g. "Rival" (falls back to User.name)
  roleLabel     String?              // e.g. "Edição de vídeo"
  // Partner's share of the main product NET, 0-100. The sum across enabled
  // partners should be 100; the admin UI surfaces the running total.
  sharePct      Float
  enabled       Boolean  @default(true)
  // Offboarded sócio: set enabled=false (leaves the commission pool, stops new
  // commissions, keeps the 100% sum across the remaining partners) + set
  // withdrawOnly=true (the partner middleware still lets them reach ONLY their
  // saque screen to cash out the remaining balance; everything else is blocked).
  withdrawOnly  Boolean  @default(false)
  payoutMethod  String?              // "mpesa" | "emola"
  payoutTarget  String?              // phone number to receive funds
  notifySale    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commissions   PartnerCommission[]
  withdrawals   PartnerWithdrawal[]
  costShares    PartnerCostShare[]

  @@index([enabled])
}

model PartnerCommission {
  id            String   @id @default(uuid())
  partnerId     String
  partner       PartnerAccount @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // = Transaction.orderId of the sale that generated this commission.
  orderId       String
  baseAmount    Float          // net pool of the order (audit)
  sharePct      Float          // snapshot of the % at sale time
  amount        Float          // baseAmount * sharePct / 100
  availableAt   DateTime       // sale date + 3 days (D+3) before withdrawable
  status        String   @default("pending") // pending | available | withdrawn | refunded
  withdrawalId  String?        // set when consumed by a withdrawal payout
  createdAt     DateTime @default(now())

  // One commission per (partner, order) — backstops webhook re-delivery.
  @@unique([partnerId, orderId])
  @@index([partnerId, status])
  @@index([availableAt, status])
  @@index([withdrawalId])
}

model PartnerWithdrawal {
  id              String   @id @default(uuid())
  partnerId       String
  partner         PartnerAccount @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amountRequested Float          // total gross (sum of net commissions consumed)
  feeAmount       Float          // 3% + 35 MZN (Lojou withdrawal fee)
  amountNet       Float          // what the partner actually receives
  payoutMethod    String         // "mpesa" | "emola"
  payoutTarget    String
  status          String   @default("pending") // pending | paid | rejected
  notes           String?
  processedAt     DateTime?
  processedBy     String?        // admin user id who approved/rejected
  createdAt       DateTime @default(now())

  @@index([partnerId, status])
  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// COSTS / EXPENSES (superadmin)
// A separate ledger so profit and partner net are DERIVED — never mutating
// transactions or commissions. See cost.service.ts.
// ═══════════════════════════════════════════════════════════════════════════
model Cost {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   @default("outro") // ferramentas | ads | salario | infra | impostos | outro
  // company → reduces company profit only. shared → split among enabled
  // partners pro-rata by sharePct (creates PartnerCostShare debits).
  allocation  String   @default("company") // company | shared
  incurredAt  DateTime @default(now())
  note        String?
  createdById String?
  createdBy   User?    @relation("CostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  costShares  PartnerCostShare[]

  @@index([incurredAt])
  @@index([allocation])
}

// One partner's pro-rata share of a "shared" cost. A debit against the
// partner's available pool: balance = available commissions − open cost shares.
// Settled (and linked to the withdrawal) when the partner withdraws.
model PartnerCostShare {
  id           String         @id @default(uuid())
  costId       String?
  cost         Cost?          @relation(fields: [costId], references: [id], onDelete: SetNull)
  partnerId    String
  partner      PartnerAccount @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount       Float          // positive — what this partner owes toward the cost
  sharePct     Float
  status       String         @default("open") // open | settled
  withdrawalId String?
  settledAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([partnerId, status])
  @@index([costId])
}

// Single-use token for the EMAIL-based password recovery flow (distinct from the
// WhatsApp/OTP flow in OtpCode). The raw token travels only in the e-mailed link;
// we persist its sha256 hash so a DB leak can't be used to reset a password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    // sha256(rawToken) — never store the plaintext token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Content / lead-magnet pages ─────────────────────────────────────────
// Standalone public pages used as Instagram organic-funnel lead magnets:
// the lead comments on a video, gets the page link, fills a gate form
// (name/WhatsApp/email) to unlock the content, then sees a CTA back to the
// Código Zero offer plus a "veja também" pointing at a related page.
// Reachable at /conteudo/{slug}. Content is a typed block array (see below).
model ContentPage {
  id        String   @id @default(uuid())
  slug      String   @unique // the unique public link: /conteudo/{slug}
  title     String
  theme     String?  // topic/tag, surfaced as "veja também sobre {theme}"
  status    String   @default("draft") // draft | published

  // Ordered list of typed blocks. Each: { id, type, ...props }. Types:
  //  heading   { level: 1|2|3, text }
  //  text      { md }                      (markdown: bold, links, lists)
  //  copyblock { label?, text }            (boxed text + copy button)
  //  image     { url, alt?, href? }
  //  button    { label, url }              (inline link/button)
  //  video     { embedHtml }               (raw iframe, same as VSL)
  //  divider   {}
  blocks    Json     @default("[]")

  // Gate copy (the lead-capture form shown before the content).
  gateHeadline String?
  gateSubtext  String?

  // Closing CTA → the Código Zero offer.
  ctaText   String?
  ctaUrl    String?

  // "Veja também" — ordered ContentPage ids shown as related recommendations.
  relatedPageIds Json @default("[]")

  // Link-preview / SEO metadata (matters a lot for IG bio/DM/comment shares).
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // Optional per-page tracking pixels (retargeting), same shape as the
  // landing's headScripts. Injected into the public page <head>.
  headScripts String?

  // Funnel counters. viewCount = page opened; leadCount = gate passed
  // (form submitted or returning lead confirmed WhatsApp).
  viewCount Int @default(0)
  leadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ── Post-purchase feedback (D+14 WhatsApp polls / D+21 suggestion ask) ──
// One row per user EVER (userId unique) holding BOTH sessions, because they
// share the channel lock: exactly ONE channel per user — 'whatsapp' (native
// polls via Komunika send-poll) or 'email' (link to the /pesquisa web form)
// — decided at first successful send and never flipped afterwards.
model FeedbackSurvey {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anchorTxnId String? // first approved non-renewal Transaction (audit trail)
  anchorAt    DateTime // that Transaction.createdAt — D+14/D+21 anchor
  channel     String? // null until first successful send: whatsapp | email

  // D+14 feedback session (consent-gated: a text ask opens the session and
  // the 4 native WhatsApp polls only start after an explicit "SIM"; "NÃO"
  // declines BOTH sessions. Adaptive pacing: voted → next in 1–2min; silent
  // → next after 30–60min; 2 silent in a row → paused; paused/consent 48h →
  // expired). While awaiting_consent, nextActionAt holds the 48h deadline.
  feedbackStatus      String    @default("scheduled") // scheduled | awaiting_consent | in_progress | paused | awaiting_web | completed | declined | expired | skipped
  feedbackDueAt       DateTime // anchor+14d, pre-staggered 30–60min apart across users
  feedbackStartedAt   DateTime?
  feedbackCompletedAt DateTime?
  currentQuestion     Int       @default(0) // index of the NEXT poll to send (0..3)
  unansweredStreak    Int       @default(0)
  nextActionAt        DateTime? // when the send tick may act on this session again
  pausedAt            DateTime?

  // D+21 suggestion session (consent-gated like the polls; the real ask goes
  // out after "SIM" and replies within 72h are stored). While
  // awaiting_consent, suggestionWindowEndsAt holds the 48h consent deadline.
  suggestionStatus       String    @default("scheduled") // scheduled | awaiting_consent | awaiting_reply | awaiting_web | completed | declined | expired | skipped
  suggestionDueAt        DateTime
  suggestionSentAt       DateTime?
  suggestionWindowEndsAt DateTime? // sentAt + 72h
  thankYouSentAt         DateTime?

  emailSentAt DateTime? // when the fallback email (web link) went out
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  responses   FeedbackResponse[]
  suggestions FeedbackSuggestion[]

  @@index([feedbackStatus, feedbackDueAt])
  @@index([suggestionStatus, suggestionDueAt])
  @@index([feedbackStatus, nextActionAt])
  // Sweep de expiração do consentimento de sugestão (tick de 2 min).
  @@index([suggestionStatus, suggestionWindowEndsAt])
}

// One row per question per survey, created AT SEND TIME with score null —
// the whatsappMessageId (send-poll's data.key.id) is what correlates the
// poll.vote webhook back to the question. Unique constraint doubles as
// idempotency against duplicate webhook deliveries (Komunika has no retry,
// but re-votes/vote-changes overwrite the same row harmlessly).
model FeedbackResponse {
  id                String         @id @default(uuid())
  surveyId          String
  survey            FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionKey       String // satisfaction | expectation | value | support
  channel           String // whatsapp | web
  whatsappMessageId String?        @unique // poll message id; null for web answers
  optionText        String? // raw option label as voted
  score             Int? // 1–4 (Abaixo do esperado → Excelente); null until answered
  sentAt            DateTime       @default(now())
  answeredAt        DateTime?

  @@unique([surveyId, questionKey])
  @@index([questionKey, score])
  @@index([answeredAt])
}

// Free-text improvement suggestions (D+21 WhatsApp replies or the /pesquisa
// textarea), listed in /admin/feedback with a read/unread flag.
model FeedbackSuggestion {
  id                String         @id @default(uuid())
  surveyId          String
  survey            FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  channel           String // whatsapp | web
  content           String
  whatsappMessageId String?        @unique // inbound msg id — dedupes webhook re-deliveries
  isRead            Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([isRead, createdAt])
  @@index([surveyId])
}
